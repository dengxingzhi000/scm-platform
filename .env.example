# =============================================================================
# SCM Platform - Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=admin
DB_PASSWORD=changeme

# Master/Slave hosts (Enterprise: read-write separation)
DB_MASTER_HOST=localhost
DB_SLAVE1_HOST=localhost
DB_SLAVE2_HOST=localhost

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=changeme

# -----------------------------------------------------------------------------
# Nacos (Service Discovery & Config Center)
# -----------------------------------------------------------------------------
NACOS_SERVER=localhost:8848
NACOS_NAMESPACE=public
NACOS_GROUP=DEFAULT_GROUP

# -----------------------------------------------------------------------------
# JWT
# -----------------------------------------------------------------------------
# 访问令牌的 HS512 签名密钥：至少 64 个字符，且 auth/gateway 与所有业务服务必须一致
# （JwtUtils 启动时会校验长度，缺失则服务无法启动；docker compose 的 core profile 强制要求）
JWT_SECRET=change-me-to-at-least-64-characters-long-random-string-0000000000

# -----------------------------------------------------------------------------
# Kafka
# -----------------------------------------------------------------------------
KAFKA_SERVERS=localhost:9092

# 审计上报目标在 Nacos 中的注册名。新镜像为 platform-audit；尚未升级镜像的旧环境
# 需设为 scm-audit，否则审计客户端解析不到实例，上报会被静默丢弃（仅有
# security_audit_delivery_failed_total 指标可见）。
COGNORA_AUDIT_SERVICE_ID=platform-audit

# -----------------------------------------------------------------------------
# RabbitMQ
# -----------------------------------------------------------------------------
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=admin
RABBITMQ_PASSWORD=changeme

# -----------------------------------------------------------------------------
# XXL-Job (Distributed Job Scheduler)
# -----------------------------------------------------------------------------
# XXL-Job 3.5.0 的 admin 使用根路径（不再带 /xxl-job-admin）
XXL_JOB_ADMIN=http://localhost:8088/
# 与调度中心配置的 xxl.job.accessToken 一致；真实值只写在 .env / scm-secrets，不提交
XXL_JOB_ACCESS_TOKEN=

# -----------------------------------------------------------------------------
# Sentinel Dashboard
# -----------------------------------------------------------------------------
SENTINEL_DASHBOARD=localhost:8858

# -----------------------------------------------------------------------------
# Gateway Security
# -----------------------------------------------------------------------------
# API Signature secrets (per application, min 32 characters)
API_SECRET_WEB_APP=
# Shared by the gateway signature filter, the internal RestClient signer
# (scm-common/web) and the scm-audit write guard. Every service that reports
# audit records must use the same value; scm-audit refuses to start when it is
# empty or still holds a shipped placeholder.
API_SECRET_INTERNAL_SERVICE=
# Legacy name for the secret above, still accepted as a fallback.
API_SECRET_INTERNAL_SECRET=

# App id sent as X-App-Id by the internal RestClient signer (an identifier, not a secret)
API_APP_ID=internal-service

# Identity token signing secret
IDENTITY_SIGNATURE_SECRET=

# mTLS keystore/truststore
KEYSTORE_PATH=classpath:certs/gateway-keystore.p12
KEYSTORE_PASSWORD=
TRUSTSTORE_PATH=classpath:certs/truststore.p12
TRUSTSTORE_PASSWORD=

# -----------------------------------------------------------------------------
# Auth Service
# -----------------------------------------------------------------------------
# SSL/TLS keystore
AUTH_KEYSTORE_PASSWORD=changeit
AUTH_TRUSTSTORE_PASSWORD=changeit

# -----------------------------------------------------------------------------
# Mail (Notification Service)
# -----------------------------------------------------------------------------
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# -----------------------------------------------------------------------------
# Environment
# -----------------------------------------------------------------------------
ENVIRONMENT=dev
RW_ENABLED=true

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
CQRS_LOG_LEVEL=INFO
SQL_LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# Alertmanager (Prometheus 告警外发)
# -----------------------------------------------------------------------------
# 告警接收 webhook，Alertmanager 以默认 JSON 载荷 POST 到此地址。
# 留空 = 当前不外发：容器使用 null receiver，告警仍可在 Prometheus /
# Alertmanager 中查看；配置后下次 docker compose up -d 生效。
ALERTMANAGER_WEBHOOK_URL=
