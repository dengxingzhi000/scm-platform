{
  "$schema": "node_modules/@openapitools/openapi-generator-cli/config.schema.json",
  "spaces": 2,
  "generator-cli": {
    "version": "7.12.0",
    "storageDir": "~/.openapi-generator",
    "generators": {
      "scm-auth-api": {
        "generatorName": "typescript-axios",
        "output": "#{cwd}/src/lib/api/generated/auth",
        "inputSpec": "../docs/api/openapi-scm-auth.json",
        "additionalProperties": {
          "withInterfaces": true,
          "useSingleRequestParameter": true,
          "supportsES6": true,
          "typescriptThreePlus": true,
          "withNodeImports": false
        },
        "globalProperty": {
          "apiDocs": false,
          "modelDocs": false
        }
      },
      "scm-system-api": {
        "generatorName": "typescript-axios",
        "output": "#{cwd}/src/lib/api/generated/system",
        "inputSpec": "../docs/api/openapi-scm-system.json",
        "additionalProperties": {
          "withInterfaces": true,
          "useSingleRequestParameter": true,
          "supportsES6": true,
          "typescriptThreePlus": true,
          "withNodeImports": false
        },
        "globalProperty": {
          "apiDocs": false,
          "modelDocs": false
        }
      },
      "scm-product-api": {
        "generatorName": "typescript-axios",
        "output": "#{cwd}/src/lib/api/generated/product",
        "inputSpec": "../docs/api/openapi-scm-product.json",
        "additionalProperties": {
          "withInterfaces": true,
          "useSingleRequestParameter": true,
          "supportsES6": true,
          "typescriptThreePlus": true,
          "withNodeImports": false
        },
        "globalProperty": {
          "apiDocs": false,
          "modelDocs": false
        }
      },
      "scm-inventory-api": {
        "generatorName": "typescript-axios",
        "output": "#{cwd}/src/lib/api/generated/inventory",
        "inputSpec": "../docs/api/openapi-scm-inventory.json",
        "additionalProperties": {
          "withInterfaces": true,
          "useSingleRequestParameter": true,
          "supportsES6": true,
          "typescriptThreePlus": true,
          "withNodeImports": false
        },
        "globalProperty": {
          "apiDocs": false,
          "modelDocs": false
        }
      },
      "scm-order-api": {
        "generatorName": "typescript-axios",
        "output": "#{cwd}/src/lib/api/generated/order",
        "inputSpec": "../docs/api/openapi-scm-order.json",
        "additionalProperties": {
          "withInterfaces": true,
          "useSingleRequestParameter": true,
          "supportsES6": true,
          "typescriptThreePlus": true,
          "withNodeImports": false
        },
        "globalProperty": {
          "apiDocs": false,
          "modelDocs": false
        }
      }
    }
  }
}
